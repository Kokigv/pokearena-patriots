# Copie este archivo a .env para cambiar valores por defecto de docker-compose.yml
APP_ENV=development
JWT_SECRET=cambie-este-secreto-en-produccion-32b
ADMIN_SUBJECTS=admin-1,admin-2
# Inicio de sesión con Google (US 116). Créelo en Google Cloud Console > APIs y servicios >
# Credenciales > ID de cliente de OAuth (aplicación web), con origen http://localhost:8080.
# Sin este valor solo funciona el usuario de prueba.
GOOGLE_CLIENT_ID=
# Segundos que se guarda en caché cada página del catálogo (0 lo desactiva).
CATALOG_CACHE_SECONDS=30