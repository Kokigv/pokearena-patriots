[importlinter]
root_package = pokearena
include_external_packages = True

[importlinter:contract:identity-layers]
name = Capas hexagonales del módulo Identidad
type = layers
layers =
    pokearena.identity.api
    pokearena.identity.infrastructure
    pokearena.identity.application
    pokearena.identity.domain

[importlinter:contract:identity-independent]
name = Identidad no depende de Catálogo
type = forbidden
source_modules =
    pokearena.identity
forbidden_modules =
    pokearena.catalog
